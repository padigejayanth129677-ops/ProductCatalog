@model IEnumerable<ProductCatalog.Models.Product>

<!DOCTYPE html>

<html>
<head>
    <title>Product Catalog</title>
</head>

<body>

    <h2>PRODUCT CATALOG</h2>

    <p>
        <a href="@Url.Action("Create", "Product")">
            Add New Product
        </a>
    </p>

    <table border="1" cellpadding="8" cellspacing="0">

        <tr>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Description</th>
            <th>Action</th>
        </tr>

        @foreach (var product in Model)
        {
            <tr>
                <td>
                    @product.ProductId
                </td>

                <td>
                    @product.ProductName
                </td>

                <td>
                    @product.Category
                </td>

                <td>
                    ₹@product.Price
                </td>

                <td>
                    @product.Quantity
                </td>

                <td>
                    @product.Description
                </td>

                <td>
                    <a href="@Url.Action("Details", "Product", new { id = product.ProductId })">
                        View Details
                    </a>
                </td>
            </tr>
        }

    </table>

</body>
</html>