@model ProductCatalog.Models.Product

<!DOCTYPE html>

<html>
<head>
    <title>Product Details</title>
</head>

<body>

    <h2>PRODUCT DETAILS</h2>

    <table border="1" cellpadding="8" cellspacing="0">

        <tr>
            <td>
                <b>Product ID</b>
            </td>

            <td>
                @Model.ProductId
            </td>
        </tr>

        <tr>
            <td>
                <b>Product Name</b>
            </td>

            <td>
                @Model.ProductName
            </td>
        </tr>

        <tr>
            <td>
                <b>Category</b>
            </td>

            <td>
                @Model.Category
            </td>
        </tr>

        <tr>
            <td>
                <b>Price</b>
            </td>

            <td>
                ₹@Model.Price
            </td>
        </tr>

        <tr>
            <td>
                <b>Quantity</b>
            </td>

            <td>
                @Model.Quantity
            </td>
        </tr>

        <tr>
            <td>
                <b>Description</b>
            </td>

            <td>
                @Model.Description
            </td>
        </tr>

    </table>

    <br />

    <a href="@Url.Action("Index", "Product")">
        Back to Product Catalog
    </a>

</body>
</html>